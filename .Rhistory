df$.y[!is.finite(df$.y)] <- NA_real_                     # set Inf/-Inf to NA (e.g., padj = 0)
df$.sig <- !is.na(df$.padj) & (df$.padj <= padj_threshold) &  # sig by padj
!is.na(df$.lfc) & (abs(df$.lfc) >= lfc_threshold)           # AND by abs(log2FC)
df$.colgrp <- ifelse(                                    # color group
df$.sig,
