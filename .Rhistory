geom_vline(xintercept = c(-lfc_threshold, lfc_threshold), col = "lightgray", linetype = "dashed") +  # LFC cutoffs
geom_hline(yintercept = -log10(padj_threshold), col = "lightgray", linetype = "dashed") +            # padj cutoff
